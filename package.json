{
  "name": "shopify-warehouse-app",
  "version": "1.0.0",
  "description": "Shopify Warehouse Management System with Picker, Transfer, and Packer",
  "main": "server/index.js",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm install && npm run build",
    "start": "node server/index.js",
    "init-db": "node -r dotenv/config server/database/init-postgres.js"
  },
  "dependencies": {
    "@preact/signals": "^2.9.2",
    "@shopify/ui-extensions": "2026.4.0",
    "axios": "^1.13.6",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "preact": "^10.29.4",
    "ws": "^8.21.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
