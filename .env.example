# Shopify API Configuration
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_STORE_URL=heratest0-1.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_access_token_here

# Server Configuration
PORT=3001
NODE_ENV=development

# App URL (for webhooks)
APP_URL=https://your-app-url.com

# Database — PostgreSQL only (SQLite support was removed). Point this at the same
# Render Postgres instance for local dev too, or your own Postgres for local-only testing.
DATABASE_URL=postgresql://user:password@host/dbname