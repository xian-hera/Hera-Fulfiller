# Shopify API Configuration
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_STORE_URL=heratest0-1.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_access_token_here

# Server Configuration
PORT=3001
NODE_ENV=development

# App URL (for webhooks)
APP_URL=https://your-app-url.com

# Database — 只支持 PostgreSQL（SQLite 已移除）
# 本地开发可以连自己电脑上的 Postgres，或者 Render 上单独建的开发库。
# ⚠️ 不建议本地直接连生产库：本地启动时会对它跑建表/迁移，本地操作也会改到真实订单数据。
DATABASE_URL=postgresql://user:password@localhost:5432/hera_fulfiller
# 可选：SSL 开关。不设置时，生产环境或连接串指向 Render 会自动开 SSL，其他情况不开。
# DATABASE_SSL=true
